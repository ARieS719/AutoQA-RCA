# ============== 环境变量模板 ==============
# 复制本文件为 .env 并填入真实值；.env 已被 .gitignore 排除，切勿提交真实密钥。

# 硅基流动 API Key（以 sk- 开头）——模板勿填真实值，真实值只放 .env
SILICONFLOW_API_KEY=

# 兼容 OpenAI 协议的统一网关地址
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# 模型选择（可按需替换为其他厂商/模型）
LLM_MODEL=deepseek-ai/DeepSeek-V3
VLM_MODEL=Qwen/Qwen3-VL-32B-Instruct
EMBEDDING_MODEL=BAAI/bge-m3

# 视觉模型超时（秒）与重试次数
VLM_TIMEOUT=60
VLM_RETRIES=3

# UI Agent 行为
MAX_STEPS=10
SCREEN_WIDTH=1408
SCREEN_HEIGHT=792
ACTION_PAUSE_SECONDS=2
REPEAT_ACTION_LIMIT=3

# 成本计量单价（元/百万 token，按厂商公开价目调整）
LLM_INPUT_PRICE_PER_1M=2
LLM_OUTPUT_PRICE_PER_1M=8

# 日志降噪黑名单（逗号分隔）
IGNORE_KEYWORDS=0x1A4,0x2B5,WifiMonitor,ActivityManager,Battery level normal

# 可选：覆盖默认目录
# DATA_DIR=
# REPORTS_DIR=
# KNOWLEDGE_FILE=
# RAG_PERSIST_DIR=
